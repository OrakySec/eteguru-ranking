# Variáveis da stack "eteguru". Preencha em Portainer > Stacks > eteguru > Environment variables.
# NÃO coloque este arquivo preenchido no Git.

# OBRIGATÓRIAS
# Domínio do site, sem https:// e sem barra no final
SITE_DOMAIN=ranking.ykaromarques.com
# Senha do banco: longa (24+ caracteres), só letras e números
POSTGRES_PASSWORD=troque_por_uma_senha_longa_so_letras_e_numeros

# OPCIONAIS (já têm valor padrão)
# @ da live, sem o arroba
TIKTOK_USERNAME=eteguru
# Chave gratuita da Euler Stream (aumenta o limite de conexões). Pode ficar vazia.
EULER_API_KEY=
# Usuário e nome do banco
POSTGRES_USER=eteguru
POSTGRES_DB=eteguru
# Imagem do app. Para voltar a uma versão anterior, use a tag do commit:
# ghcr.io/orakysec/eteguru-ranking-app:<hash-do-commit>
APP_IMAGE=ghcr.io/orakysec/eteguru-ranking-app:latest
# false desliga a conexão com a live (útil para manutenção)
COLLECTOR_ENABLED=true
